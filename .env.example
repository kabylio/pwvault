# Generate real values with:  python scripts/gen_secrets.py
# Never commit the real .env file.
PWVAULT_JWT_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
PWVAULT_SERVER_KEY=base64-of-32-random-bytes
PWVAULT_DATABASE_URL=sqlite:///./pwvault_server.db
PWVAULT_TOKEN_MINUTES=15
# WebAuthn passkeys: set these to the exact public site origin in deployment.
PWVAULT_WEBAUTHN_RP_ID=localhost
PWVAULT_WEBAUTHN_ORIGIN=http://localhost:8000
# Comma-separated. Accounts REGISTERED with these e-mails become administrators.
# Register the admin account right after first start (no e-mail verification yet).
PWVAULT_ADMIN_EMAILS=admin@bank.dz
# Breached-password check (Have I Been Pwned, k-anonymity). OFF by default:
# enabling it makes the SERVER call api.pwnedpasswords.com. Point PWVAULT_HIBP_URL
# at an internal mirror if the bank forbids outbound calls.
PWVAULT_BREACH_CHECK=0
# open = anyone can register (development). invite = admins issue single-use codes (production).
PWVAULT_REGISTRATION=invite
